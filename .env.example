# Claimless — environment variables (no secrets committed)
# Copy to .env and fill in. Never commit .env.

# ── Chain: Monad testnet (10143) ────────────────────────────────────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
# Deployer key. Leave empty until you are ready to deploy.
MONAD_PRIVATE_KEY=
# Optional mainnet RPC (only for reading mainnet registries)
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz

# ── Monad testnet USDC (Circle) ─────────────────────────────────────────────
# VERIFIED 2026-09-15. Re-verify bytecode at build time: testnet resets can
# redeploy canonical contracts.
MONAD_TESTNET_USDC=0x534b2f3A21130d7a60830c2Df862319e593943A3

# ── ERC-8004 canonical registries ───────────────────────────────────────────
# Deterministic addresses, same on every chain per network class.
# Testnet pair (Monad 10143):
ERC8004_IDENTITY_TESTNET=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_TESTNET=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Mainnet pair (Monad 143):
ERC8004_IDENTITY_MAINNET=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_MAINNET=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# ── Deployed Claimless contracts (filled after Deploy.s.sol) ─────────────────
INCIDENT_REGISTRY_ADDRESS=
RISK_SCORE_ADDRESS=
AGENT_IDENTITY_ADDRESS=
COVER_POOL_ADDRESS=
PARAMETRIC_TRIGGER_ADDRESS=

# ── Envio (indexer) ─────────────────────────────────────────────────────────
# Free API token from https://envio.dev/app/api-tokens (needed for HyperSync).
# Token-free fallback: run the indexer with CONFIG_FILE=config.rpc.yaml, which
# reads MONAD_RPC_URL instead of HyperSync. See indexer/README.md.
ENVIO_API_TOKEN=
# Selects the indexer config file. "config.yaml" = HyperSync (needs the token),
# "config.rpc.yaml" = token-free RPC via MONAD_RPC_URL.
CONFIG_FILE=config.yaml
# Host port for the indexer's own Postgres. 5433, NOT 5432: 5432 is already
# occupied on this machine by agentic-scraper-postgres + a local Postgres.
ENVIO_PG_PORT=5433
# Host port for Hasura GraphQL (8080 may be taken). Console: :8081/console
HASURA_EXTERNAL_PORT=8081

# ── Nansen (risk-score enrichment) ──────────────────────────────────────────
# Free plan: 100 trial credits, then 10/day. Cache aggressively.
NANSEN_API_KEY=

# ── Privy (autonomous agent wallets) ────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# ── Mera (human passkey account layer) ──────────────────────────────────────
# No API key needed. Nothing to configure; kept for documentation.
MERA_ENABLED=true

# ── Aurora Intents (any-chain deposits) ─────────────────────────────────────
# App key from https://studio.aurora.dev (not confidential). Not required for
# dry:true quotes via 1click.chaindefuser.com.
AURORA_INTENTS_APP_KEY=
AURORA_INTENTS_BASE_URL=https://intents-api.aurora.dev

# ── Chainlink CRE (trigger orchestration) ───────────────────────────────────
CRE_API_KEY=
CRE_FORWARDER_ADDRESS=

# ── Optional: MetaMask Agent Wallet plugin (Week 3) ─────────────────────────
METAMASK_PLUGIN_CHAIN_ID=10143
