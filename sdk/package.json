{
  "name": "@claimless/sdk",
  "version": "0.1.0",
  "description": "Claimless SDK — read the on-chain agent risk registry and report incidents on Monad",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts",
    "registry:demo": "tsx scripts/registry-demo.ts",
    "risk:demo": "tsx scripts/risk-demo.ts",
    "envio:demo": "tsx scripts/envio-demo.ts",
    "erc8004:demo": "tsx scripts/erc8004-demo.ts",
    "nansen:demo": "tsx scripts/nansen-demo.ts",
    "mera:demo": "tsx scripts/mera-demo.ts",
    "verify": "tsx scripts/verify.ts",
    "privy:demo": "tsx --env-file=../.env scripts/privy-demo.ts",
    "intents:demo": "tsx scripts/intents-demo.ts",
    "report": "tsx scripts/report.ts"
  },
  "dependencies": {
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
