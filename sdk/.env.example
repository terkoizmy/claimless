# Claimless SDK — environment variables (copy to .env)
# Read paths need NOTHING: public RPC + local GraphQL have defaults.
# Only write paths and sponsor integrations need values here.

# ── Chain / RPC ──────────────────────────────────────────────────────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Required only for write paths (reportIncident, publishRiskSummary, deploys).
# Leave empty to use read-only features.
MONAD_PRIVATE_KEY=

# ── Envio indexer GraphQL ────────────────────────────────────────────────────
CLAIMLESS_GRAPHQL_URL=http://localhost:8081/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=testing

# ── ERC-8004 ─────────────────────────────────────────────────────────────────
# Addresses are baked into src/config.ts (they are deterministic). No vars needed.

# ── Aurora Intents ───────────────────────────────────────────────────────────
# Dry quotes work with NO key via https://1click.chaindefuser.com.
AURORA_INTENTS_APP_KEY=
AURORA_INTENTS_BASE_URL=https://intents-api.aurora.dev
ONECLICK_BASE_URL=https://1click.chaindefuser.com

# ── Nansen ───────────────────────────────────────────────────────────────────
# Free plan: 100 trial credits, then 10/day. The SDK caches responses.
NANSEN_API_KEY=

# ── Privy (autonomous agent wallets) ─────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Chainlink CRE ────────────────────────────────────────────────────────────
CRE_API_KEY=
