# Claimless indexer environment (copy to .env and fill after contract deploy).
# All values in this file are placeholders; do not commit real secrets.

# --- Contract addresses (required, set after `forge script Deploy` broadcast) ---
# IncidentRegistry proxy/deployment address on Monad testnet (chain 10143).
# Mirrored from contracts/deployments/monad-testnet.json -> contracts.incidentRegistry
INCIDENT_REGISTRY_ADDRESS=

# RiskScore deployment address on Monad testnet.
# Mirrored from contracts/deployments/monad-testnet.json -> contracts.riskScore
RISK_SCORE_ADDRESS=

# --- Data source ---
# HyperSync API token (free) from https://envio.dev/app/api-tokens
# Required when indexing via HyperSync (config.yaml, the default).
# NOT required when running the token-free RPC path (config.rpc.yaml).
ENVIO_API_TOKEN=

# Public Monad testnet RPC (fallback data source for config.rpc.yaml).
# Default per contracts/deployments/monad-testnet.json -> resources.rpc
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Selects the data source for docker/local runs:
#   config.yaml      -> HyperSync (needs ENVIO_API_TOKEN)
#   config.rpc.yaml  -> RPC via MONAD_RPC_URL (token-free; no ENVIO_USE_RPC
#                       flag exists in Envio's runtime - switching configs is
#                       the supported way to choose the sync source)
CONFIG_FILE=config.yaml

# --- Self-hosted stack (docker-compose.yaml) ---
# CRITICAL: Postgres host port is 5433, NOT 5432. Host port 5432 is already
# occupied on this machine (agentic-scraper-postgres + local Postgres).
ENVIO_PG_PORT=5433
ENVIO_PG_USER=postgres
ENVIO_PG_PASSWORD=testing
ENVIO_PG_DATABASE=envio-dev
ENVIO_PG_PUBLIC_SCHEMA=envio

# Hasura host port is 8081 (8080 may be taken). Console: http://localhost:8081/console
HASURA_EXTERNAL_PORT=8081
HASURA_GRAPHQL_ADMIN_SECRET=testing
HASURA_GRAPHQL_ENABLE_CONSOLE=true

# Envio indexer metrics/health port (host-bound to 127.0.0.1).
ENVIO_INDEXER_PORT=9898

# Non-TTY environments (CI, docker): disable the terminal UI.
TUI_OFF=true